{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    "development-basic": {
      "extends": "development",
      "env": { "BESEEN_SCREEN_TIME": "off" }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": { "buildType": "apk" }
    },
    "preview-basic": {
      "extends": "preview",
      "channel": "preview-basic",
      "env": { "BESEEN_SCREEN_TIME": "off" }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
